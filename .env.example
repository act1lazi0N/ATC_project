# Required. Generate by: openssl rand -base64 32
JWT_SECRET=replace_this_with_your_generated_secret

# Spring profile: dev, docker, or test
SPRING_PROFILES_ACTIVE=docker

# Required for docker compose and local dev
POSTGRES_DB=aries_transaction_db
POSTGRES_USER=transfer_user
POSTGRES_PASSWORD=your_strong_password

# Swagger/OpenAPI is disabled by default outside dev
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
