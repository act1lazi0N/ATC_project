# Required. Generate by: openssl rand -base64 32
JWT_SECRET=replace_this_with_your_generated_secret
SECURITY_EPHEMERAL_KEY_HASH_SECRET=replace_this_with_a_second_generated_secret
SECURITY_EPHEMERAL_ENABLED=true
SECURITY_EPHEMERAL_DUPLICATE_TTL_SECONDS=30
SECURITY_EPHEMERAL_REPLAY_TTL_SECONDS=300

# Spring profile: dev, docker, or test. Production should use docker,prod.
SPRING_PROFILES_ACTIVE=docker

# Exact comma-separated browser origins. Production must not use loopback origins.
AUTH_REFRESH_ALLOWED_ORIGINS=http://localhost:3000

# Required for docker compose and local dev
POSTGRES_DB=aries_transaction_db
POSTGRES_USER=transfer_user
POSTGRES_PASSWORD=your_strong_password

# Financial workflow policy defaults
ACCOUNT_MAX_ACTIVE_ACCOUNTS_PER_USER=5
TRANSFER_PREVIEW_TTL_MINUTES=5
TRANSFER_PREVIEW_RATE_LIMIT_WINDOW_SECONDS=60
TRANSFER_PREVIEW_USER_REQUESTS=30
TRANSFER_PREVIEW_IP_REQUESTS=120
TRANSFER_PREVIEW_MINIMUM_RESPONSE_MILLIS=50
TRANSFER_PREVIEW_RETENTION_HOURS=24
TRANSFER_PREVIEW_CLEANUP_ENABLED=true
TRANSFER_PREVIEW_CLEANUP_FIXED_DELAY_MS=3600000

# Swagger/OpenAPI is disabled by default outside dev
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
