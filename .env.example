# Required. Generate by: openssl rand -base64 32
JWT_SECRET=replace_this_with_your_generated_secret
SECURITY_EPHEMERAL_KEY_HASH_SECRET=replace_this_with_a_second_generated_secret
SECURITY_EPHEMERAL_ENABLED=true
SECURITY_EPHEMERAL_DUPLICATE_TTL_SECONDS=30
SECURITY_EPHEMERAL_REPLAY_TTL_SECONDS=300

# Spring profile: dev, docker, or test. Production should use docker,prod.
SPRING_PROFILES_ACTIVE=docker

# Exact comma-separated browser origins. Production must not use loopback origins.
AUTH_REFRESH_ALLOWED_ORIGINS=http://localhost:3000

# Required for docker compose and local dev
POSTGRES_DB=aries_transaction_db
POSTGRES_USER=transfer_user
POSTGRES_PASSWORD=your_strong_password

# Financial workflow policy defaults
ACCOUNT_MAX_ACTIVE_ACCOUNTS_PER_USER=5
TRANSFER_PREVIEW_TTL_MINUTES=5
TRANSFER_PREVIEW_RATE_LIMIT_WINDOW_SECONDS=60
TRANSFER_PREVIEW_USER_REQUESTS=30
TRANSFER_PREVIEW_IP_REQUESTS=120
TRANSFER_PREVIEW_MINIMUM_RESPONSE_MILLIS=50
TRANSFER_PREVIEW_RETENTION_HOURS=24
TRANSFER_PREVIEW_CLEANUP_ENABLED=true
TRANSFER_PREVIEW_CLEANUP_FIXED_DELAY_MS=3600000

# Swagger/OpenAPI is disabled by default outside dev
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# Notification fan-out and SMTP email remain disabled until explicitly configured.
OUTBOX_WORKER_ENABLED=false
OUTBOX_PUBLISHER=noop
WEBHOOK_FANOUT_ENABLED=false
NOTIFICATION_FANOUT_ENABLED=false
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_DELIVERY_ATTEMPT_RETENTION_DAYS=30
NOTIFICATION_CLEANUP_ENABLED=true
NOTIFICATION_CLEANUP_INTERVAL_MS=3600000
NOTIFICATION_EMAIL_MODE=disabled
NOTIFICATION_EMAIL_WORKER_ENABLED=false
NOTIFICATION_EMAIL_FROM=no-reply@aries.local
NOTIFICATION_PUBLIC_BASE_URL=http://localhost:3000/verify-email
# Generate a separate 256-bit Base64 key before requesting email verification.
EMAIL_VERIFICATION_SIGNING_KEY=replace_with_a_separate_base64_256_bit_key
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=false
SPRING_MAIL_STARTTLS_ENABLE=false
# Production requires both STARTTLS flags and server identity verification to be true.
SPRING_MAIL_STARTTLS_REQUIRED=false
SPRING_MAIL_SSL_CHECK_SERVER_IDENTITY=true

# To send real email through Gmail, replace the local Mailpit settings above:
# NOTIFICATION_EMAIL_MODE=smtp (not "enable")
# NOTIFICATION_EMAIL_WORKER_ENABLED=true
# NOTIFICATION_EMAIL_FROM=<same Gmail address as SPRING_MAIL_USERNAME>
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=<sender Gmail address>
# SPRING_MAIL_PASSWORD=<Google App Password, not the account password>
# SPRING_MAIL_AUTH=true
# SPRING_MAIL_STARTTLS_ENABLE=true
# SPRING_MAIL_STARTTLS_REQUIRED=true
# Keep credentials only in the ignored .env file or a deployment secret store.